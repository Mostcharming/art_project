# SAMPLE: verify service user and log paths before placing in /etc/logrotate.d/carsl.
# The PM2 ecosystem config names this service "apis".
/root/.pm2/logs/apis-out.log /root/.pm2/logs/apis-error.log {
    daily
    rotate 30
    maxage 30
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root root
}
# Apply an equivalent 30-day retention rule to the Carsl virtual host's Nginx
# logs and any provider/CDN logs. Do not rotate another site's logs blindly.
