{
  "expo": {
    "name": "carslTV",
    "slug": "carslTV",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "carsl",
    "userInterfaceStyle": "dark",
    "platforms": ["android"],
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.carsl.tv",
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "android.intent.action.MAIN",
          "category": ["android.intent.category.LEANBACK_LAUNCHER"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BankGothicBold.ttf",
            "./assets/fonts/BankGothicMdBT.ttf",
            "./assets/fonts/BankGothicLightRegular.otf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f8f97ec-99d0-4201-8e7a-197a5f2d56f2"
      }
    },
    "owner": "mostcharming"
  }
}
